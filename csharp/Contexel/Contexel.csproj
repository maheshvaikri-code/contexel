<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Contexel</RootNamespace>

    <PackageId>Contexel</PackageId>
    <Version>0.1.16</Version>
    <Authors>Mahesh Vaikri</Authors>
    <Description>Deterministic, dependency-free context shaping for code-writing agents — C# parity of the Python package, enforced by shared golden vectors.</Description>
    <PackageTags>llm;agents;context-engineering;tokens;tool-use;rag</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://maheshvaikri-code.github.io/contexel/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/maheshvaikri-code/contexel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Contexel.Tests" />
  </ItemGroup>

</Project>
